---
import { render } from "astro:content";
import { getCollection } from "astro:content";

const testimonials = await getCollection("testimonials");
const selectedTestimonials = testimonials.sort((a, b) =>
	a.data.author.localeCompare(b.data.author),
);
---

<style>
    
	figure {
		margin: 0;
		margin-block: 0;
		margin-inline: 0.2rem;
		display: grid;
		grid-template-rows: max-content max-content;
		align-items: center;
		break-inside: avoid;
		padding: 1.5em 1.5em 0 1.5em;
        display: none;
	}
	figure:nth-of-type(3n + 1) {
		background-color: var(--card-background);
	}
	figure:nth-of-type(3n + 2) {
		background-color: var(--border);
	}

	figure:nth-of-type(4n-1) {
		background-color: var(--scene-background);
	}

	blockquote {
		position: relative;
		margin: 0;
		padding-block: 0rem;
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--color-secondary);
		text-align: right;
	}
	.testimonials {
		column-width: 20em;
		column-gap: 0;
		column-rule: 0.43rem solid var(--border);
	}
	.testimonials :global(a) {
		color: inherit;
	}
	.tags {
		list-style: none;
		margin-block: 1em;
		font-size: 0.8em;
		flex-wrap: wrap;
		column-gap: 0.5em;
		row-gap: 0.25em;
		justify-content: end;
		opacity: 0.75;
		li {
			display: inline;
			word-spacing: 0.75em;
			word-break: keep-all;
			hyphens: none;
		}
	}
	.testimonials :global(details) {
		background-color: inherit;
		border: 0.1em dotted var(--foreground);
	}
	.testimonials :global(summary) {
		list-style: initial;
		margin-left: 0;
	}
	.note {
		font-size: 0.8em;
		line-height: 1em;
		font-style: italic;
		opacity: 0.9;
		text-align: left;
		border-top: 0.1em dotted var(--foreground);
		padding: 0.5em;
	}
    .testimonial-container{
        display: grid;
        grid-template-columns: max-content 1fr max-content;
        align-content: center;


        h2{
            grid-column: 1 / 4;
            grid-row: 1 / 2;

        }
        #next {
            grid-column: 3 / 4;
            grid-row: 2 / 3;
        }
        .cta{
            grid-column: 2 / 3;
            grid-row: 2 / 3;
            text-align: center;

        }
        #previous{
            grid-column: 1 / 2;
            grid-row: 2 / 3;

        }
        .testimonials{
            grid-column: 1 / 4;
            grid-row: 3 / 4;

        }

        button{
            background-color: var(--background);
            border: 0;
            color: var(--foreground);

            span{
                clip: rect(1px, 1px, 1px, 1px);
                clip-path: inset(50%);
                height: 1px;
                width: 1px;
                margin: -1px;
                overflow: hidden;
                padding: 0;
                position: absolute;
            }

        }
        #previous::after {
            font-size: 3em;
            content: '<';
            color: var(--highlight);
            display: block;
        }
        #next::after {
                        font-size: 3em;

            content: '>';
            color: var(--highlight);
            display: block;
        }



    }
    
</style>
<div class="testimonial-container">
    <h2>Perspectives on Toki Pona</h2>
    <p class="cta">Read all on our page</p>
    <button id="next"><span>Next</span></button>
    <button id="previous"><span>Previous</span></button>
    <div class="testimonials">
        {
            selectedTestimonials.map(async (testimonial) => {
                const { Content } = await render(testimonial);
                return (
                    <figure class:list={testimonial.data.tags}>
                        <blockquote>
                            <Content />
                        </blockquote>
                        <figcaption>
                            — <cite>{testimonial.data.author}</cite>
                            <ul class="tags">
                                {testimonial.data.tags.map((tag) => (
                                    <li>#{tag} </li>
                                ))}
                            </ul>
                            {testimonial.data.notes && (
                                <p class="note">{testimonial.data.notes}</p>
                            )}
                        </figcaption>
                    </figure>
                );
            })
        }
    </div>
</div>

<script>
	function scrambleTestimonials() {
		const container = document.querySelector("div.testimonials");
		if (!container) return; //straight out of claude, so improve it if you know a better solution

		const figures = [...container.querySelectorAll("figure")];

		// Fisher-Yates shuffle
		for (let i = figures.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[figures[i], figures[j]] = [figures[j], figures[i]];
		}

		// Re-append in shuffled order
		figures.forEach((fig) => container.appendChild(fig));
	}
    function iterateTestimonials(){
		const figures = document.querySelector("div.testimonials").querySelectorAll("figure");
        const next = document.getElementById("next");
        const previous = document.getElementById("previous");
        const breakpoint = figures.length - 1;
        let current = 0;
        set("grid");
        next.addEventListener("click", () => {
            set("");
            current ++;
            set("grid");
        })
        previous.addEventListener("click", () => {
            set("");
            current --;
            set("grid");

        })
        function set(value){
            if(current == -1) current = breakpoint;
            else if (current > breakpoint) current = 0;
            figures[current].style.display = value;

        }



    }

	scrambleTestimonials();
	document.addEventListener("astro:page-load", scrambleTestimonials);
    	iterateTestimonials();
	document.addEventListener("astro:page-load", iterateTestimonials);

</script>
