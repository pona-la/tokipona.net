---
import FAQChild from "@/components/faq/FAQChild.astro";
import { getCollection, getEntry, render } from "astro:content";
const kasi = (
	await getCollection("faqEntries", ({ data }) => {
		return data.published == true && data.faq_group == 3;
	})
).sort((a, b) => a.data.faq_index.valueOf() - b.data.faq_index.valueOf());

import { Image } from "astro:assets";
import { faqImages } from "@/data/faqImages";
const imagesSRC = kasi.map((entry) =>
	entry.data.image ?
		faqImages["/src/assets/sitelen/faq/" + entry.data.image]?.default
	:	null,
);
---

<style>
	:root {
		--faq-child: black;
	}
	.intro {
		background-color: var(--card-border);
		color: var(--foreground);
		grid-column: 1 / 3;

		a {
			color: inherit;
		}
	}

	.garden {
		width: 100%;
		margin: 0 auto;
		display: flex;
		flex-wrap: nowrap;
		position: relative;
		top: 0.4em;
		background-color: black;

		img {
			max-width: 100%;
			user-drag: none;
			user-select: none;
			width: 100%;
			height: auto;
		}
	}
</style>

<FAQChild
	faq_title={"Deeper Insights"}
	title={"Deeper Insights | Toki Pona FAQ"}
	description={"Answers to nuanced questions regarding the language with 130 words."}
	draft
	nextLink={undefined}
	prevLink={"/faq/using-toki-pona/"}
	nextText={undefined}
	array={kasi}
>
	<div class="garden">
		{
			kasi.map((entry) =>
				entry.data.image ?
					<div>
						<Image src={faqImages[entry.data.image]} alt="" />
					</div>
				:	"",
			)
		}
	</div>

	<div class="faq soweli">
		<div class="intro">
			<h2>Deeper Insights</h2>
		</div>
	</div>
</FAQChild>
