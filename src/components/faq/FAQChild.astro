---
import { Image } from "astro:assets";
import { faqImages } from "@/data/faqImages";
import type { PublishedFaqEntry } from "./faq";

interface Props {
	title: string;
	description: string;
	draft?: boolean;
	entries: PublishedFaqEntry[];
	faq_title: string;
	nextLink?: string;
	prevLink?: string;
	nextText?: string;
}

const { entries } = Astro.props;
---

<style>
	:global(.intro) {
		padding-block: 1em !important;

		:global(h2) {
			padding: 0em;
			margin: 0em;
			font-size: 1.1em;

			line-height: 1em;
			&::after {
				display: none;
			}
		}
	}

	.right-toc {
		position: sticky;
		top: 1rem;
		line-height: 1.7;
	}
	.small-toc {
		display: none;
		margin-bottom: 0.5rem;
		max-width: 30em;
		margin-inline: auto;
	}
	@media only screen and (max-width: 1200px) {
		.right-toc {
			display: none !important;
		}
		.small-toc {
			display: block;
		}
	}
	ol li {
		& a {
			color: var(--foreground);
			text-decoration: none;
			&:hover {
				text-decoration: underline;
			}
		}
		&::marker {
			content: counter(list-item) "  ";
			color: var(--foreground-muted);
			width: 2ch;
			text-align: right;
			padding-right: 1ch;
			display: block;
		}
	}
	.main-content {
		max-width: 35em;
		margin: 0 auto;
	}
	.space-maker {
		width: 6rem;
		height: 1rem;
		float: left;
	}
	.plant {
		width: 5rem;
		z-index: 2;
		position: absolute;
		display: block;
		white-space: normal;
		margin-top: -2rem;
		padding: 0;
		float: left;
		border: none;
		background: none;

		summary::before {
			content: none;
		}

		img {
			max-width: 100%;
			border-radius: 50%;
			border: 0.5em solid var(--card-border);
			float: left;
			background-color: var(--faq-child, var(--card-background));
			width: 100%;
			height: auto;
		}
	}
	.faq :global(h3) {
		&::after {
			z-index: 1;
		}
	}

	.entry-wrap :global(h3) {
		padding-left: 5.5rem;
		margin-inline: 0;
		text-align: left;
	}
	.summary {
		width: 70vw;
		max-width: 25em;

		border-color: var(--scene-background);
		border-style: solid;
		border-end-end-radius: var(--rounding-large);
		border-start-end-radius: var(--rounding-large);
		border-end-start-radius: var(--rounding-large);
		border-width: 0.2em 0.4em 0.4em 0.2em;
		background-color: var(--background);
		z-index: 4;
		padding: 1em;
		background-color: rgb(22, 33, 22);
		color: lightcyan;
	}

	:global(.faq) {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: var(--background);
		width: 100%;
	}
	:global(section) {
		padding-inline: 0;
	}

	.summary {
		position: absolute;
		left: inherit;
		right: inherit;
		top: inherit;
		bottom: inherit;
		margin-top: 1em;
		margin-left: 4em;
		list-style-type: none;
	}

	.summary {
		z-index: 4;
	}
	.faqnext {
		width: 100%;
		grid-column: 1 / 3;
		display: grid;
		padding: 1em;

		grid-template-columns: auto 1fr;
		align-items: center;

		.prev {
			margin-left: 2em;
		}

		div {
			grid-column: 2 / 3;
			justify-self: end;
			display: grid;

			span a {
				font-size: 2em;
			}
		}
	}

	.entry-section {
		position: relative;
		display: grid;
		gap: 0em;
		justify-items: center;
		.entry-wrap {
			break-inside: avoid;
			max-width: 42em;
			padding-inline: 2em;
		}
	}
	.entry-content :global(p) {
		margin-bottom: 1em;
	}

	.entry-title::after {
		content: "";
		display: block;
		position: absolute;
		left: 50%;
		bottom: 0;
		translate: -50% 0;
		width: 100%;
		border-bottom: 6px solid var(--border);
		margin-left: auto;
		margin-right: auto;
		border-radius: var(--rounding-small);
		z-index: 1;
	}
	.entry-title {
		line-height: 1.2;
		position: relative;
		font-weight: bold;
		font-size: 1.5rem;
		width: 100%;
		padding-bottom: 1rem;
		text-align: center;
		padding-left: 5.5rem;
		margin-inline: 0;
		text-align: left;
		scroll-margin-top: 3em;
	}

	.entry-section:has(.kasi) img {
		background-color: var(--background);
		box-shadow:
			#c3bb1840 0 1.5em 3em -0.6em inset,
			#eff2cd4d 0 0.9em 1.8em -0.9em inset;
	}

	.entry-section:has(.waso) img {
		background-color: var(--scene-background);
	}
	.entry-section:has(.soweli) img {
		background-color: #000;
	}

	:global(#footnote-label) {
		display: none;
	}
</style>

<div class="entry-section">
	<slot />

	{
		entries.map(async (item) => (
			<article class="entry-wrap">
				<h3 class="entry-title" id={item.id}>
					{item.data.title}
				</h3>
				<div class="entry">
					<details class="plant">
						<summary class="plant">
							<Image alt="Show summary" src={faqImages[item.data.image]} />
						</summary>
						<div class="summary" id={`icon${item.id}`}>
							{item.data.simple}
						</div>
					</details>
					<div set:html={item.rendered!.html} class="entry-content">
						<div class="space-maker" />
					</div>
				</div>
			</article>
		))
	}
</div>

<script is:inline>
	function lightDismiss() {
		console.log("mu");

		document.querySelectorAll("details.plant").forEach((details) => {
			details.addEventListener("toggle", () => {
				// Only run when the state changes to open
				if (details.open) {
					// Define the outside click handler function
					const closeOnOutsideClick = (clickEvent) => {
						if (!details.contains(clickEvent.target)) {
							details.removeAttribute("open");
							// Self-cleanup: remove this listener immediately
							document.removeEventListener("click", closeOnOutsideClick);
						}
					};

					// Delay listener attachment slightly to prevent immediate triggering from the summary click
					setTimeout(() => {
						document.addEventListener("click", closeOnOutsideClick);
					}, 0);
				}
			});
		});
	}
	document.addEventListener("DOMContentLoaded", lightDismiss);
</script>
