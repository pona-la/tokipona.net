---
import FAQChild from "@/components/faq/FAQChild.astro";

const kasi = await getFaqEntries(2);

import { Image } from "astro:assets";
import { faqImages } from "@/data/faqImages";
import { getFaqEntries } from "./faq";
---

<style>
	.intro {
		padding: 0.2em;
		grid-column: 1 / 3;
		background-color: var(--card-background);
		color: var(--link);
	}

	.garden {
		margin: 0 auto;
		display: flex;
		background: var(--faq-child);
		border-radius: var(--rounding-large);
		margin-bottom: -3em;

		mask:
			radial-gradient(64.41px at 50% 87px, #000 99%, #0000 101%)
				calc(50% - 60px) 0/120px 51% repeat-x,
			radial-gradient(64.41px at 50% -57px, #0000 99%, #000 101%) 50% 30px/120px
				calc(51% - 30px) repeat-x,
			radial-gradient(64.41px at 50% calc(100% - 87px), #000 99%, #0000 101%)
				calc(50% - 60px) 100%/120px 51% repeat-x,
			radial-gradient(64.41px at 50% calc(100% + 57px), #0000 99%, #000 101%)
				50% calc(100% - 30px) / 120px calc(51% - 30px) repeat-x;

		flex-wrap: nowrap;
		position: relative;
		top: 0.4em;
		img {
			max-width: 90%;
			user-drag: none;
			user-select: none;
			margin-block: 3em;
			width: 100%;
			height: auto;
		}
	}
	body {
		--faq-child: var(--scene-background);
	}
</style>

<FAQChild
	faq_title={"Using Toki Pona"}
	title={"Using Toki Pona | Toki Pona FAQ"}
	description={"Discover how speakers use Toki Pona: the language with 130 words."}
	draft
	nextLink={"/faq/insights/"}
	prevLink={"/faq/basics/"}
	nextText={"Deeper Insights"}
	entries={kasi}
>
	<div class="garden">
		{
			kasi.map((entry) =>
				entry.data.image ?
					<div>
						<Image src={faqImages[entry.data.image]} alt="" />
					</div>
				:	"",
			)
		}
	</div>

	<div class="faq">
		<div class="intro waso">
			<h2>Using Toki Pona</h2>
		</div>
	</div>
</FAQChild>
