---
import FAQChild from "@/components/faq/FAQChild.astro";
import { getCollection, getEntry, render } from "astro:content";
const kasi = (
	await getCollection("faqEntries", ({ data }) => {
		return data.published == true && data.faq_group == 1;
	})
).sort((a, b) => a.data.faq_index.valueOf() - b.data.faq_index.valueOf());

import { Image } from "astro:assets";
import { faqImages } from "@/data/faqImages";
---

<style>
	.intro {
		background-color: rgb(22, 33, 22);
		color: lightcyan;
		padding: 0.2em;

		a {
			color: inherit;
		}
	}

	.garden {
		width: 100%;
		max-width: 50em;
		margin: 0 auto;
		display: flex;
		flex-wrap: nowrap;
		position: relative;
		top: 0.4em;

		img {
			max-width: 100%;
			user-drag: none;
			user-select: none;
			width: 100%;
			height: auto;
		}
	}
</style>

<FAQChild
	faq_title={"The Basics"}
	title={"The Basics | Toki Pona FAQ"}
	description={"Answers to common questions regarding the language with 130 words."}
	array={kasi}
	nextLink={"/faq/using-toki-pona/"}
	prevLink={undefined}
	nextText={"Using Toki Pona"}
	draft
>
	<div class="garden">
		{
			kasi.map((entry) =>
				entry.data.image ?
					<div>
						<Image src={faqImages[entry.data.image]} alt="" />
					</div>
				:	"",
			)
		}
	</div>

	<div class="faq kasi">
		<div class="intro">
			<h2>The Basics</h2>
		</div>
	</div>
</FAQChild>
