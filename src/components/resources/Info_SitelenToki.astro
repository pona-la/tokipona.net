---
import type { Resource } from "./FilterFor.astro";
import { Image } from "astro:assets";

import { resourceImages } from "@/data/resourceImages";

interface Props {
	entry: Resource;
	hideCat: boolean;
}

const { entry, hideCat } = Astro.props;
const isSvg = entry.img?.endsWith(".svg");
// @ts-expect-error
const image = entry.img ? resourceImages[entry.img]?.default : null;
---

<style>
	img {
		width: 100%;
		height: auto;
	}
</style>
<li>
	<a href={entry.link} target="_blank" rel="noopener noreferrer">
		{entry.name}</a
	>

	<span class="cat">{hideCat ? "·" : entry.category}</span>

	<a
		aria-hidden="true"
		href={entry.link}
		target="_blank"
		rel="noopener noreferrer"
		tabindex="-1"
	>
		{
			image &&
				(isSvg ? <img src={image.src} alt="" /> : <Image src={image} alt="" />)
		}</a
	>

	{entry.description && <p>{entry.description}</p>}
</li>
