---
const { name, category, withImg } = Astro.props;
import FilterFor from "./FilterFor.astro";
---

<style>
	div.resourcebox {
		ul {
			padding-inline-start: 0.5em;
			list-style-type: disc;

			background-color: inherit;

			h3 {
				text-align: center;
				margin-block-start: 0em;
			}
			li {
				display: list-item;
				list-style-type: disc;
				padding: 0em;
				padding-bottom: 0.25em;

				a {
					font-size: 1em;
					padding-inline-end: 0.25em;
					font-weight: 600;
				}
				p {
					display: inline;
				}
				.cat {
					display: none;
				}
			}
		}
		p {
			text-align: center;
		}
	}
</style>
<div class="resourcebox">
	<h3>More {name}</h3>

	<ul>
		<FilterFor
			name={name}
			withImg={withImg}
			hideCat={true}
			category={category}
		/>
		<slot />
	</ul>
</div>
