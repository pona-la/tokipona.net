---
const { body } = Astro.props;
---

<style>
	.more,
	.resourcebox {
		font-size: 0.9em;
		border: 0.2em solid var(--card-background);
		padding: 1em;
		border-radius: var(--rounding-large);
	}
	.more:has(.horizon) {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
</style>

<div class="more">
	{body}
	<slot />
</div>
