---
// ToolsSection.astro was generated by Claude because Lakuse doesn't know how to work Astro.
// Recursively renders one category node from tools.yaml as a heading
// followed by either nested sub-sections or a <ul> of tool links.

interface ToolItem {
  name: string;
  description?: string | null;
  link?: string | null;
}

interface ToolCategory {
  category: string;
  children: (ToolItem | ToolCategory)[];
}

interface Props {
  node: ToolCategory;
  level?: number; // heading level to render this node at (h2, h3, ...)
}

const { node, level = 2 } = Astro.props;

// Clamp so we never try to render past h6
const headingLevel = Math.min(Math.max(level, 1), 6);
const HeadingTag = `h${headingLevel + 1}`;

function isCategory(child: ToolItem | ToolCategory): child is ToolCategory {
  return (child as ToolCategory).category !== undefined;
}

// Walk this node's children in order, grouping consecutive leaf tools
// into a single <ul>, and treating nested categories as their own
// recursive sub-sections. This preserves the original ordering even
// if leaves and sub-categories are interleaved.
type Group =
  | { type: "items"; items: ToolItem[] }
  | { type: "category"; node: ToolCategory };

const groups: Group[] = [];

for (const child of node.children ?? []) {
  if (isCategory(child)) {
    groups.push({ type: "category", node: child });
  } else {
    const last = groups[groups.length - 1];
    if (last && last.type === "items") {
      last.items.push(child);
    } else {
      groups.push({ type: "items", items: [child] });
    }
  }
}
---


<style>
    .tool-entry :global(h3){

        font-size: 1em;
        text-align: start;
        margin: 0em;
        font-weight: 800;
        width: max-content;
        padding: 0.1em 0.5em 0.25em 0.5em;        
     border-radius: 1em;
        border: 0.1em solid var(--foreground-muted);
        color: var(--foreground-muted);
        text-transform: lowercase;



    }
    .tool-entry h4{
        font-size: 1em;
        margin: 0.2em 0em 0.2em 0em;
        font-weight: 400;
        border-radius: 1em;
        text-transform: lowercase;
        font-style: italic;
        width: 100%;
        color: var(--foreground);
        position: relative;
        background-color: var(--background);
        z-index: 2;
        /*text-decoration: underline;
        text-decoration-style:wavy;
        text-decoration-color: var(--scene-background);
        text-decoration-thickness: 0.1em;*/

    }
    .tool-entry h4::after{
        content: "";
        display: block;
        position: absolute;
        top: 1.2em;
        width: 100%;
        height: 0.3em;
        z-index: -1;
        background-color: var(--scene-background);
        opacity: 0.8;
    }
    .tool-entry:has(h3){
        margin-inline-start: 1em;
        margin-bottom: 2em;

    }
    .tool-entry:has(h4):not(:has(h3)){
        
    }
    .tool-entry ul{
        padding: 0em;
        margin: 0em 0em 0em 1em;
    }
    .tool-entry a{
        font-weight: 700;
    }
    .tool-entry{
        break-inside: avoid;
        
    }
    .tool-entry li{
        text-indent: 0.75em hanging;
    }
         .tool-entry:nth-of-type(5) { 
        grid-column: 2 / 3;
        grid-row: 1 / 4;
    }


     .tool-entry:last-of-type { 
        grid-column: 2 / 3;
        grid-row: 4 / 5;
    }

</style>

<div class="tool-entry">
    <HeadingTag>{node.category}</HeadingTag>
    
    {
      groups.map((group) =>
        group.type === "items" ? (
          <ul>
            {group.items.map((item) => (
              <li>
                {item.link ? (
                  <a href={item.link}>{item.name}</a>
                ) : (
                  <span>{item.name}</span>
                )}
                {item.description ? ` - ${item.description}` : null}
              </li>
            ))}
          </ul>
        ) : (
          <Astro.self node={group.node} level={headingLevel + 1} />
        )
      )
    }
</div>