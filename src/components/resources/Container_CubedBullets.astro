---
import FilterFor from "@/components/resources/FilterFor.astro";
const { name, category, withImg } = Astro.props;
---

<style>
	.inperson {
		margin: 0 auto;
		padding: 0;
		padding-inline: 1em;
		max-width: max-content;

		li {
			display: grid;
			grid-template-columns: auto 1fr;
			column-gap: 2em;
			.cat {
				display: none;
			}

			a:has(img) {
				width: 3em;
				height: 3em;
				grid-row: 1 / 3;
			}
			img {
				width: 3em;
				height: 3em;

				border-radius: var(--rounding-small);
			}
			span {
				font-weight: 600;
			}
		}
	}
	@media (max-width: 40em) {
		.inperson {
			li {
				display: list-item;
			}
			img {
				float: right;
				margin: 1em;
			}
		}
	}
</style>

<ul class="inperson">
	<FilterFor name={name} category={category} hideCat={true} withImg={withImg} />
	<slot />
</ul>
