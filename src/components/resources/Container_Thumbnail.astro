---
import FilterFor from "@/components/resources/FilterFor.astro";
const { name, category, withImg } = Astro.props;

---
<style>
.playlist {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 1em;
			margin: 0;
			padding: 0;
			margin-block-end: 3em;

			img {
				width: 8em;
				padding: 1em;
				height: 4.5em;
				border: 0.2em solid black;
				background-color: var(--foreground-muted);
				mix-blend-mode: difference;

			}
			li {
				display: grid;
				text-align: center;

				a:not(:has(img)) {
                    grid-row: 2 / 3;
					max-width: 8em;
					text-decoration: none;
					font-weight: 600;
					line-height: 1.1em;
					text-align: center;
                    margin-block-start: 1em;
				}

                .cat {
                    display: none;
                }
                a:has(img){
                    grid-row: 1 / 2;


                }
			}
			li:has(a:hover) a {
				text-decoration: underline;
			}

		}
.dark .playlist img{
padding: 5em;
}



</style>

		<ul class="playlist">

						<FilterFor
                        name={name} category={category} withImg={withImg}></FilterFor>
            <slot />

		</ul>
