---
import Banner from "@/assets/banner.svg";
import Cols from "@/components/Cols.astro";
import MaSeka from "@/components/MaSeka.astro";
import HomepageGrid from "@/components/home/HomepageGrid.astro";
---

<style>
	.caveat {
		text-decoration: none;
	}
	p .caveat {
		font-size: 1.5em;
		font-weight: 800;
	}
	p:has(.caveat) {
		text-align: center;
	}

	.banner {
		display: flex;
		justify-content: center;
	}
	blockquote {
		position: relative;
		width: fit-content;
		font-size: 1.125rem;
		margin: 0;
		padding: 0.5rem 1.5rem;

		&::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 6px;
			height: 100%;
			background-color: var(--border);
			border-radius: var(--rounding-small);
		}
	}
	@media only screen and (max-width: 750px) {
		blockquote {
			padding: none;
			text-align: center;
			&::before {
				display: none;
			}
		}
	}

	:global(:has(#wan:checked)) {
		.first {
			display: block;
		}
		.second {
			display: none;
		}
		.third {
			display: none;
		}
		.fourth {
			display: none;
		}
	}

	:global(:has(#tu:checked)) {
		.first {
			display: none;
		}
		.second {
			display: block;
		}
		.third {
			display: none;
		}
		.fourth {
			display: none;
		}
	}
	:global(:has(#tuwan:checked)) {
		.first {
			display: none;
		}
		.second {
			display: none;
		}
		.third {
			display: block;
		}
		.fourth {
			display: none;
		}
	}
	:global(:has(#tutu:checked)) {
		.first {
			display: none;
		}
		.second {
			display: none;
		}
		.third {
			display: none;
		}
		.fourth {
			display: block;
		}
	}
</style>

<h1>
	Toki Pona: the language of 120<a
		class="caveat"
		id="open-caveat"
		href="#pini-caveat">*</a
	> words
</h1>

<div class="banner"><Banner /></div>

<HomepageGrid />

<p>
	<a class="caveat" id="pini-caveat" href="#open-caveat">*</a>As much as it is
	possible to exactly count the words in any language. <br /><a
		href="/faq/#basics/how-many-words"
		>Varies from 120-140 depending on the speaker.</a
	>
</p>

<h2>Learn via videos!</h2>

<Cols>
	<blockquote>
		What is Toki Pona?<br /><b>A quick overview:</b>
	</blockquote>
	<MaSeka
		maSekaId="rekqFP6E1gHc2GReP32vRr"
		youtubeId="U3GQePblz4M"
		name="What is Toki Pona?"
	/>
</Cols>

<Cols>
	<blockquote style="grid-area: 1/2">
		<b>How can one communicate</b><br />when limited to such a small set of
		words?<br />Find out now!
	</blockquote>
	<MaSeka
		maSekaId="1mARGx3NrQUfRhyZJKMn8v"
		youtubeId="7rVWvwWLUBg"
		name="Context and Toki Pona // English Version"
	/>
</Cols>

<Cols>
	<blockquote>
		<b>Start learning now!</b><br />This video contains<br />ALL the grammatical
		rules.
	</blockquote>
	<MaSeka
		maSekaId="qWs9SArgT9S6sdY2JAegJ7"
		youtubeId="5phj5Ae80h8"
		name="Toki Pona in 18 Minutes"
	/>
</Cols>
