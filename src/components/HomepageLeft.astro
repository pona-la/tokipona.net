---
import Banner from "@/assets/banner.svg";
import Cols from "@/components/Cols.astro";
import MaSeka from "@/components/MaSeka.astro";
// import Video from "@/components/Video.astro";
import Version1 from "@/components/home/ver1.astro"
import Version2 from "@/components/home/ver2.astro"
import Version3 from "@/components/home/ver3.astro"
import Version4 from "@/components/home/ver4.astro"

---

<style>
	.banner {
		display: flex;
		justify-content: center;
	}
	blockquote {
		position: relative;
		width: fit-content;
		font-size: 1.125rem;
		margin: 0;
		padding: 0.5rem 1.5rem;

		&::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			width: 6px;
			height: 100%;
			background-color: var(--border);
			border-radius: var(--rounding-small);
		}
	}
	@media only screen and (max-width: 750px) {
		blockquote {
			padding: none;
			text-align: center;
			&::before {
				display: none;
			}
		}
	}
		
	:global(:has(#wan:checked)) {

		.first{
			display: block;
		}
		.second{
			display: none;
		}
		.third{
			display: none;
		}
		.fourth{
			display: none;
		}
	}


	:global(:has(#tu:checked)){
		.first{
			display: none;
		}
		.second{
			display: block;
		}
		.third{
			display: none;
		}
		.fourth{
			display: none;
		}
	}
	:global(:has(#tuwan:checked)){
		.first{
			display: none;
		}
		.second{
			display: none;
		}
		.third{
			display: block;
		}
		.fourth{
			display: none;
		}
	}
	:global(:has(#tutu:checked)){
		.first{
			display: none;
		}
		.second{
			display: none;
		}
		.third{
			display: none;
		}
		.fourth{
			display: block;
		}
	}



		
	

</style>

<label class="version" for="wan"><input type="radio" name="version" id="wan" checked>first version</label>
<label class="version" for="tu"><input type="radio" name="version" id="tu">second version</label>
<label class="version" for="tuwan"><input type="radio" name="version" id="tuwan">third version</label>
<label class="version" for="tutu"><input type="radio" name="version" id="tutu">fourth version</label>



<div class="banner"><Banner /></div>

<div class="first">
	<Version1 />
</div>
<div class="second">
	<Version2 />
</div>
<div class="third">
	<Version3 />
</div>
<div class="fourth">
	<Version4 />
</div>



<h2>Learn via videos!</h2>

<Cols>
	<blockquote>
		What is Toki Pona?<br /><b>A quick overview:</b>
	</blockquote>
	<MaSeka maSekaId="rekqFP6E1gHc2GReP32vRr" youtubeId="U3GQePblz4M" name="What is Toki Pona?" />
</Cols>


<Cols>
	<blockquote style="grid-area: 1/2">
		<b>How can one communicate</b><br />when limited to such a small set of
		words?<br />Find out now!
	</blockquote>
	<MaSeka maSekaId="1mARGx3NrQUfRhyZJKMn8v" youtubeId="7rVWvwWLUBg" name="Context and Toki Pona // English Version" />
</Cols>



<Cols>
	<blockquote>
		<b>Start learning now!</b><br />This video contains<br />ALL the grammatical
		rules.
	</blockquote>
	<MaSeka maSekaId="qWs9SArgT9S6sdY2JAegJ7" youtubeId="5phj5Ae80h8" name="Toki Pona in 18 Minutes" />
</Cols>
