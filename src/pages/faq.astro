---
import Layout from "@/layouts/Layout.astro";
import { compiledContent as toki } from "@/content/rapid-fire.md";
import Basic from "@/components/faq/basics.astro";
import Using from "@/components/faq/using-toki-pona.astro";

import Insights from "@/components/faq/insights.astro";
import { getFaqEntries } from "@/components/faq/faq";

const kasi = await getFaqEntries(1);
const waso = await getFaqEntries(2);
const soweli = await getFaqEntries(3);
---

<style>
	:body {
	}
	.above-description {
		max-width: 30em;
		text-align: center;
		margin: 0 auto;

		a {
			color: inherit;
		}
	}
	.right-toc {
		position: sticky;
		top: 1rem;
		line-height: 1.7;
	}
	.small-toc {
		display: none;
		margin-bottom: 0.5rem;
		max-width: 30em;
		margin-inline: auto;
	}
	@media only screen and (max-width: 1200px) {
		.right-toc {
			display: none !important;
		}
		.small-toc {
			display: block;
		}
	}
	ol li {
		& a {
			color: var(--foreground);
			text-decoration: none;
			&:hover {
				text-decoration: underline;
			}
		}
		&::marker {
			content: counter(list-item) "  ";
			color: var(--foreground-muted);
			width: 2ch;
			text-align: right;
			padding-right: 1ch;
			display: block;
		}
	}

	.right-toc,
	.small-toc {
		--toc-highlight-color: var(--card-border);
		--toc-quick-margin: -0.5em 0em;

		&:is(details) {
			--toc-highlight-color: var(--card-border);
			--toc-quick-margin: -0.5em 1.5em;
		}

		ul li:not(.quick-toc) {
			display: flex;
			align-items: center;

			span {
				writing-mode: sideways-lr;
				line-height: 1em;
			}
			ol {
				border-left: 0.25em solid var(--toc-highlight-color);
				position: relative;
				padding: 0;
				margin: 0em 0em 0em 0.2em;

				list-style-type: none;

				li::before {
					position: absolute;
					left: -2em;
					top: 0;
					font-size: 0.9em;
					counter-increment: entries;
					content: counters(entries, "") "";
					opacity: 0.6;
					text-align: center;
					width: 2em;
				}

				li {
					position: relative;
					margin-left: 2em;
					margin-bottom: 0.5em;
					line-height: 1.2em;
				}
			}
		}
		ul {
			display: grid;
			counter-reset: entries;
			row-gap: 1em;
			padding-left: 0.75em;
			padding-right: 0.75em;
			margin-block: 0.5em;
		}
		.quick-toc {
			list-style: none;
			text-align: center;
			line-height: 1em;
			margin-block: var(--toc-quick-margin);

			a {
				color: inherit;
				text-decoration: none;
				border-bottom: 0.25em solid var(--toc-highlight-color);
			}
		}
		.quick-toc::before {
			content: "+";
			padding-right: 0.5em;
		}
	}

	.ijo {
		display: flex;
		list-style-type: none;
		row-gap: 1em;
		flex-wrap: wrap;
		justify-content: space-evenly;
		max-width: 40em;
		margin: 0 auto;
	}

	.ijo li {
		margin: 0;
		aspect-ratio: 1 / 1;
		max-width: 10em;
		position: relative;
		display: grid;
		grid-template-rows: max-content 1fr;
	}
	.ijo a {
		text-align: center;
		display: grid;
		text-decoration: none;
		padding: 1em 0.25em;
	}
	.ijo span {
		align-self: center;
	}
	.ijo a::after {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		right: 0;
		left: 0;
	}

	.kasi {
		li {
			box-shadow:
				rgba(195, 187, 24, 0.25) 0px 30px 60px -12px inset,
				rgba(239, 242, 205, 0.3) 0px 18px 36px -18px inset;
		}
		a {
			background-color: rgb(22, 33, 22);
			color: lightcyan;
		}
	}
	.waso {
		li {
			background-color: var(--scene-background);
		}
		a {
			background-color: rgb(52, 78, 58);
			color: lightcyan;
		}
	}
	.soweli {
		li {
			background-color: black;
		}
		a {
			background-color: rgb(210, 172, 47);
			color: rgb(29, 61, 61);
		}
	}
	.quick {
		padding: 2em;
		column-width: 15em;
		gap: 2em;
		.quick-child {
			break-inside: avoid;

			h3 {
				padding-top: 0em;
				margin-top: 0em;
			}
			p {
				margin-bottom: 2em;
			}
		}
	}
</style>

<Layout
	title={"Frequently Asked Questions | Toki Pona"}
	description={"Find answers to frequently asked questions about Toki Pona, a constructed language with a small vocabulary."}
>
	<section style="grid-area: right;" class="right-toc">
		<ul>
			<li>
				<span class="toc-section-title"> The Basics </span>
				<ol>
					{
						kasi.map((item) => (
							<li>
								<a href={`#${item.id}`}>{item.data.title}</a>
							</li>
						))
					}
				</ol>
			</li>
			<li>
				<span class="toc-section-title"> Using Toki Pona </span>

				<ol>
					{
						waso.map((item) => (
							<li>
								<a href={`#${item.id}`}>{item.data.title}</a>
							</li>
						))
					}
				</ol>
			</li>
			<li>
				<span class="toc-section-title"> Deeper Insights </span>

				<ol>
					{
						soweli.map((item) => (
							<li>
								<a href={`#${item.id}`}>{item.data.title}</a>
							</li>
						))
					}
				</ol>
			</li>
			<li class="quick-toc"><a href="#quick-questions">Quick Questions</a></li>
		</ul>
	</section>
	<section style="grid-area: left;">
		<h1>Toki Pona: Frequently Asked Questions</h1>

		<p class="above-description">
			Our FAQ is a little bit long. We've recruited some <a
				title="plants"
				href="https://nimi.li/kasi">kasi</a
			>, <a title="birds" href="https://nimi.li/waso">waso</a>, and <a
				title="mammals"
				href="https://nimi.li/soweli">soweli</a
			> to prepare very condensed summaries of each answer. Click on the image next
			to the question. They will try to help out!
		</p>

		<details class="small-toc">
			<summary> Table of Contents </summary>
			<ul>
				<li>
					<span class="toc-section-title">The Basics</span>
					<ol>
						{
							kasi.map((item) => (
								<li>
									<a href={`#${item.id}`}>{item.data.title}</a>
								</li>
							))
						}
					</ol>
				</li>
				<li>
					<span class="toc-section-title">Using Toki Pona</span>
					<ol>
						{
							waso.map((item) => (
								<li>
									<a href={`#${item.id}`}>{item.data.title}</a>
								</li>
							))
						}
					</ol>
				</li>
				<li>
					<span class="toc-section-title">Deeper Insights</span>
					<ol>
						{
							soweli.map((item) => (
								<li>
									<a href={`#${item.id}`}>{item.data.title}</a>
								</li>
							))
						}
					</ol>
				</li>
				<li class="quick-toc">
					<a href="#quick-questions">Quick Questions</a>
				</li>
			</ul>
		</details>

		<Basic />
		<Using />
		<Insights />

		<h2 id="quick-questions">Quick Questions</h2>

		<div class="quick">
			{
				//generated with claude's help because i don't know astro
				(async () => {
					let fuck = (await toki()).split("<h3").slice(1);
					return fuck.map((a) => (
						<div class="quick-child" set:html={"<h3" + a}>
							{" "}
						</div>
					));
				})()
			}
		</div>
	</section>
</Layout>
