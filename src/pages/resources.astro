---
import Layout from "@/layouts/Layout.astro";
import SinKulupu from "@/components/resources/SinKulupu.astro";
import Container_Nested from "@/components/resources/Container_Nested.astro";
import ContainerSitelenToki from "@/components/resources/Container_SitelenToki.astro";
import ContainerSitelenLiliToki from "@/components/resources/Container_SitelenLiliToki.astro";

import SeeMore from "@/components/resources/SeeMore.astro";
import ContainerCircles from "@/components/resources/Container_Circles.astro";
import Container_CubedBullets from "@/components/resources/Container_CubedBullets.astro";
import Container_Simple from "@/components/resources/Container_Simple.astro";
import Container_Thumbnail from "@/components/resources/Container_Thumbnail.astro";
import ToolList from "@/components/resources/ToolsList.astro";

import booksImage from "@/assets/sitelen/resources/bookshelf.svg";
import warningImage from "@/assets/sitelen/resources/warning.svg";
---

<Layout
	title={"Resources and Links | Toki Pona (Homepage)"}
	description={"Curated links to Toki Pona courses, communities, and other content."}
>
	<style>
		@media (min-height: 690px) {
			.stuck-scroll {
				position: sticky;
				top: 1rem;
			}
		}
		@media only screen and (max-width: 1200px) {
			.stuck-scroll {
				position: static;
			}
		}
		@media only screen and (min-width: 1201px) {
			.stuck-scroll {
				/* Prevent side container's details from causing overflow where you can't view it*/
				max-height: 100vh;
				overflow: auto;
			}
		}

		section :global(h2) {
			text-align: left;
			padding-inline-start: 1em;
			font-size: 1.7em;
		}
		section :global(h3) {
			text-align: center;
		}

		p.uncontained {
			padding: 0.5em 1.5em;
		}

		.communities-flex .more {
			max-width: 30em;
			margin: 0 auto;
			display: flex;
			flex-direction: column;
			justify-content: space-evenly;
		}
		.book {
			width: 10em;
			float: right;
		}
		.warning img {
			width: 4em;
			max-height: 4em;
		}
		.warning {
			display: flex;
			gap: 1em;
		}
		.spacer {
			height: 2em;
			width: 100%;
		}
		.right-toc nav {
			background-color: var(--card-background);
			max-width: 15em;
			border-radius: var(--rounding-small);
			padding: 0.5em 2em;
			margin-inline: auto;
		}
		.right-toc h2::after {
			display: none;
		}
		.right-toc h2 {
			padding: 0em;
			margin: 0em;
			text-transform: uppercase;
			font-size: 0.8em;
			margin: 0.25em auto;
			text-align: center;
			border-block-end: 0.3em solid var(--card-border);
		}
		.right-toc ul {
			font-size: 1.15em;
			padding: 0em;
			margin: 0em;
		}
		.right-toc ul a {
			color: inherit;
		}
		.radio img {
			max-width: 100%;
			max-height: 13em;
			margin: 0 auto;
		}
		.radio {
			display: flex;
			flex-direction: column;
			margin-block-end: 2em;
		}

		@media (min-width: 30em) {
			.communities-flex {
				display: grid;
				grid-template-columns: minmax(10em, 1.5fr) minmax(5em, 1fr);
			}
			.radio {
				flex-direction: row;
			}
		}
		@media (max-width: 25em) {
			.warning {
				display: block;
			}
			.warning img {
				width: 2em;
				height: 2em;
				margin: 0 auto;
				display: block;
			}
			.warning span {
				display: block;
			}
		}
	</style>
	<section style="grid-area: right;" class="right-toc stuck-scroll">
		<h1>Resources</h1>

		<nav aria-labelledby="the-toc">
			<h2 id="the-toc">Table of Contents</h2>
			<ul>
				<li><a href="#communities">Communities</a></li>
				<li><a href="#courses">Courses</a></li>
				<li><a href="#reference">Reference Material</a></li>
				<li><a href="#reading">Reading Practice</a></li>
				<li><a href="#listening">Listening Practice</a></li>
				<li><a href="#music">Music</a></li>

				<li><a href="#tools">Tools</a></li>
			</ul>
		</nav>
		<p class="uncontained">
			<strong>A map to Toki Pona learning and community resources</strong>. For
			even more links, visit the <a href="https://sona.pona.la/wiki/Main_Page"
				>sona pona</a
			> wiki, which has deep-dive articles for all of categories.
		</p>
	</section>

	<section style="grid-area: left;">
		<h2 id="communities">Communities</h2>
		<p class="uncontained">
			Where to get involved? Where to ask questions, to get feedback, to
			converse, to share your Toki Pona work? Join a community, <strong
				lang="tok"><em>o kama lon kulupu!</em></strong
			>
		</p>

		<h3>Online</h3>
		<ContainerCircles name="Online" category="community" withImg={true} />

		<div class="communities-flex">
			<div>
				<h3>In-Person</h3>

				<Container_CubedBullets
					name="In-Person"
					category="inperson"
					withImg={true}
				/>
			</div>
			<SeeMore>
				<h3>More communities</h3>
				<p class="horizon">
					There are many more communities besides those we've listed here. If
					you're looking for a language-specific or place-specific community, or
					communities on platforms not listed here, consult the full list of all
					known Toki Pona communities on sona pona's <a
						href="https://sona.pona.la/wiki/Communities"
						><strong>Communities</strong></a
					> article.
				</p>

				<p>
					A language isn't a language without people to speak it to. We highly
					encourage you to connect with other speakers!
				</p>
			</SeeMore>
		</div>

		<SinKulupu />
		<h2 id="courses">Courses</h2>

		<p class="uncontained">
			Start learning Toki Pona with one of the many community-authored courses
			available for free online.
		</p>

		<ContainerSitelenToki name="Courses" withImg={true} category="course">
			<li>
				<SeeMore>
					<Container_Nested name="courses" category="course" withImg={false}>
						<p>
							Even more courses listed on sona.pona.la, <br /><a
								href="https://sona.pona.la/wiki/Learning_resources#Video_lessons"
								>Learning Resources</a
							>
						</p>
					</Container_Nested>
				</SeeMore>
			</li>
		</ContainerSitelenToki>

		<h2 id="reference">Reference</h2>

		<ContainerSitelenLiliToki
			name="Reference"
			withImg={true}
			category="reference"
		/>

		<h2 id="reading">Reading Practice</h2>

		<img class="book" alt="books on a shelf" src={booksImage.src} />

		<p class="uncontained">
			<strong
				>Individual titles can be found listed at sona pona (<a
					href="https://sona.pona.la/wiki/Literature">Literature</a
				> | <a href="https://sona.pona.la/wiki/List_of_works_by_length"
					>List of works by length</a
				> | <a href="https://sona.pona.la/wiki/Comics">Comics</a>) and on the
				digital library, <a href="https://lipu.pona.la/">lipu Lapo</a></strong
			>. Besides lipu Lapo, we've listed a couple of websites that host multiple
			works below:
		</p>

		<Container_Simple name="Online" category="reading" withImg={false} />

		<p class="uncontained">
			Another excellent way to practice reading in Toki Pona is through video
			games: speakers made <a href="https://itch.io/jam/tu/results">32 games</a> in
			the 2026 pali musi game jam, and <a href="https://itch.io/jam/mu/results"
				>34 games</a
			> in 2025. There are other titles of both original and translated games listed
			on sona.pona.la's <a href="https://sona.pona.la/wiki/Games#Video_games"
				>Games</a
			> article, including Minecraft, Celeste, Legend of Zelda, and Slay the Spire.
		</p>

		<p class="uncontained warning">
			<img alt="Danger warning sign" src={warningImage.src} />

			<span
				><strong
					>Be careful about purchasing reading material from Amazon</strong
				>; many (though not all) of the titles available there are generated by
				LLMs and are almost completely incoherent, published by people who do
				not know Toki Pona.</span>
		</p>

		<div class="spacer"></div>

		<h2 id="listening">Listening Practice</h2>

		<p class="uncontained">
			There are Toki Pona vloggers, streamers, and presenters on YouTube, but
			they can be difficult to find. These organized (and regularly updated) <strong
				>playlists</strong
			> make it easier to find what you're looking for.
		</p>

		<Container_Thumbnail withImg={true} category="playlist" />

		<p class="uncontained">
			Folks looking to build their receptive listening skills may find these
			resources particularly helpful:
		</p>

		<ContainerSitelenToki
			name="Reference"
			withImg={true}
			category="listening"
		/>
		<h2 id="music">Music</h2>
		<p class="uncontained">
			There are <a
				href="https://www.youtube.com/playlist?list=PLc7R2x5fn6AqRFUR9JzGIqh0FMdtsXRnH
"
				>over 1000 Toki Pona songs</a
			> available on YouTube and <a
				href="https://open.spotify.com/playlist/0jNVZdISRRIuExWtYov6I1"
				>more than 8 hours of Toki Pona songs</a
			> streaming on Spotify.
		</p>

		<p class="uncontained radio">
			<span
				>If this sounds overwhelming, you might wish to check out the <a
					href="https://kute.pona.la">Toki Pona radio</a
				>. Listen on your browser, YouTube or Twitch.</span
			><a aria-hidden="true" href="https://kute.pona.la/"
				><img
					style="margin:0 auto"
					src="https://kute.pona.la/header.svg"
					alt=""
				/></a>
		</p>

		<h2 id="tools">Tools</h2>

		<ToolList />

		<Container_Simple name="Online" category="tools" withImg={false} />
	</section>
</Layout>
