---
import FAQChild from "@/layouts/FAQChild.astro";
import { getCollection, getEntry, render } from "astro:content";
const kasi = (
	await getCollection("faqEntries", ({ data }) => {
		return data.published == true && data.faq_group == 3;
	})
).sort((a, b) => a.data.faq_index.valueOf() - b.data.faq_index.valueOf());

---

<style>
	:root{
		--faq-child: black;
	}
	.intro {
		background-color: var(--card-border);
		color: var(--foreground);
		border-radius: var(--rounding-small);
		padding: 0.2em;
		grid-column: 1 / 3;

		a {
			color: inherit;
		}
	}

	.garden {
		width: 100%;
		margin: 0 auto;
		display: flex;
		flex-wrap: nowrap;
		position: relative;
		top: 0.4em;
		background-color: black;

		img {
			max-width: 100%;
			user-drag: none;
			user-select: none;
		}
	}
</style>

<FAQChild
	faq_title={"Deeper Insights"}
	title={"Deeper Insights | Toki Pona FAQ"}
	description={"Answers to nuanced questions regarding the language with 130 words."}
	draft
	nextLink={undefined}
	prevLink={"/faq/using-toki-pona/"}
	nextText={undefined}


	array={kasi}
>
	<div class="garden">
		{
			kasi.map((item) => (
				<div>
					<img src={`/sitelen/kasi/${item.data.image}`} />
				</div>
			))
		}
	</div>

	<div class="faq">
		<div class="intro">
			<h1>Deeper Insights</h1>
		</div>
	</div>
</FAQChild>
